<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TermKeyDangerFlex">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:background">@drawable/key_button_danger_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="TermKeyFlex">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_marginEnd">3dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:background">@drawable/key_button_bg</item>
        <item name="android:textColor">#FF191919</item>
        <item name="android:maxLines">1</item>
        <!-- 宽窄自适应字号：按键等宽均分后，"PGUP/HOME/END" 这类长标签在窄屏
             会被截断成 "PG"/"HO"（2026-10-05 真机实测）。改为按可用宽度自动
             缩放（8–11sp），保证标签完整可读；短标签（↑/ESC）仍取上限 11sp。 -->
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">11sp</item>
    </style>
</resources>
